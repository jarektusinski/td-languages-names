{
  "name": "td-languages-names",
  "version": "1.1.0",
  "description": "TypeScript/JavaScript library with 232 language names in English and in their native script (for example 日本語, Polski, العربية). Includes bidirectional mappings, validation helpers, and typed language constants.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarektusinski/td-languages-names.git"
  },
  "homepage": "https://github.com/jarektusinski/td-languages-names#readme",
  "bugs": {
    "url": "https://github.com/jarektusinski/td-languages-names/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "languages",
    "language-names",
    "native-names",
    "internationalization",
    "localization",
    "locale",
    "translation",
    "language-selector",
    "typescript",
    "constants",
    "language-list",
    "endonym",
    "exonym",
    "language-data"
  ],
  "author": "Jarosław Tusiński",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
